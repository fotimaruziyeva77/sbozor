{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sbozor.uz/agent/v1/events/modules.schema.json",
  "title": "Modul hodisalari (market.*, parking.*, livestock.*) — `data` sxemalari",
  "$defs": {
    "file_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plate": {
      "description": "Normal shakl: katta harf, bo'sh joy va chiziqchasiz (01A123BC).",
      "type": "string",
      "pattern": "^[0-9A-Z]{4,12}$"
    },
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},

    "market.occupancy.observed": {
      "type": "object",
      "required": ["slot", "stalls"],
      "additionalProperties": false,
      "properties": {
        "slot": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "stalls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stall_code", "verdict"],
            "additionalProperties": false,
            "properties": {
              "stall_code": {"type": "string"},
              "verdict": {"type": "string", "enum": ["occupied", "empty", "uncertain", "no_coverage"]},
              "confidence": {"$ref": "#/$defs/confidence"},
              "file_id": {"$ref": "#/$defs/file_id"}
            }
          }
        }
      }
    },
    "market.payment.recorded": {
      "type": "object",
      "required": ["stall_code", "amount_soum", "method", "staff_id"],
      "additionalProperties": false,
      "properties": {
        "stall_code": {"type": "string"},
        "amount_soum": {"type": "integer", "minimum": 1},
        "method": {"type": "string", "enum": ["cash", "terminal"]},
        "staff_id": {"type": "string"}
      }
    },

    "parking.plate.read": {
      "type": "object",
      "required": ["lane_id", "plate", "confidence", "direction"],
      "additionalProperties": false,
      "properties": {
        "lane_id": {"type": "string"},
        "plate": {"$ref": "#/$defs/plate"},
        "raw_text": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "direction": {"type": "string", "enum": ["in", "out"]},
        "file_id": {"$ref": "#/$defs/file_id"}
      }
    },
    "parking.session.opened": {
      "type": "object",
      "required": ["session_id", "lane_id", "category", "reason"],
      "additionalProperties": false,
      "properties": {
        "session_id": {"type": "string", "format": "uuid"},
        "plate": {"$ref": "#/$defs/plate"},
        "lane_id": {"type": "string"},
        "category": {"type": "string"},
        "reason": {"type": "string", "enum": ["auto", "manual", "no_plate"]},
        "ticket_no": {"type": "integer", "minimum": 1},
        "file_id": {"$ref": "#/$defs/file_id"}
      }
    },
    "parking.session.priced": {
      "type": "object",
      "required": ["session_id", "tariff_version", "amount_soum"],
      "additionalProperties": false,
      "properties": {
        "session_id": {"type": "string", "format": "uuid"},
        "tariff_version": {"type": "integer", "minimum": 1},
        "amount_soum": {"type": "integer", "minimum": 0},
        "breakdown": {"type": "array"}
      }
    },
    "parking.session.closed": {
      "type": "object",
      "required": ["session_id", "lane_id", "amount_soum"],
      "additionalProperties": false,
      "properties": {
        "session_id": {"type": "string", "format": "uuid"},
        "lane_id": {"type": "string"},
        "amount_soum": {"type": "integer", "minimum": 0},
        "payment_ids": {"type": "array", "items": {"type": "string"}},
        "duration_minutes": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "enum": ["paid", "free", "manual", "online"]}
      }
    },
    "parking.gate.opened": {
      "type": "object",
      "required": ["lane_id", "reason"],
      "additionalProperties": false,
      "properties": {
        "lane_id": {"type": "string"},
        "reason": {"type": "string", "enum": ["session", "paid", "pass", "manual", "free_mode"]},
        "staff_id": {"type": "string"},
        "command_id": {"type": "string", "format": "uuid"},
        "file_id": {"$ref": "#/$defs/file_id"}
      }
    },
    "parking.gate.passage": {
      "type": "object",
      "required": ["lane_id", "count"],
      "additionalProperties": false,
      "properties": {"lane_id": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}
    },
    "parking.gate.mode_changed": {
      "type": "object",
      "required": ["lane_id", "from", "to", "actor"],
      "additionalProperties": false,
      "properties": {
        "lane_id": {"type": "string"},
        "from": {"type": "string", "enum": ["auto", "manual", "free"]},
        "to": {"type": "string", "enum": ["auto", "manual", "free"]},
        "actor": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "parking.anomaly.detected": {
      "type": "object",
      "required": ["kind", "lane_id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["double_passage", "double_entry", "open_without_session", "no_open_session", "blacklist", "manual_open"]},
        "lane_id": {"type": "string"},
        "plate": {"$ref": "#/$defs/plate"},
        "file_id": {"$ref": "#/$defs/file_id"}
      }
    },
    "parking.impound.received": {
      "type": "object",
      "required": ["impound_id", "protocol_no"],
      "additionalProperties": false,
      "properties": {
        "impound_id": {"type": "string", "format": "uuid"},
        "protocol_no": {"type": "string"},
        "plate": {"$ref": "#/$defs/plate"},
        "vin": {"type": "string", "pattern": "^[A-HJ-NPR-Z0-9]{17}$"},
        "file_ids": {"type": "array", "items": {"$ref": "#/$defs/file_id"}}
      }
    },
    "parking.impound.released": {
      "type": "object",
      "required": ["impound_id", "permit_no"],
      "additionalProperties": false,
      "properties": {
        "impound_id": {"type": "string", "format": "uuid"},
        "permit_no": {"type": "string"},
        "file_ids": {"type": "array", "items": {"$ref": "#/$defs/file_id"}}
      }
    },

    "livestock.count.observed": {
      "description": "Kamera sanagan oqim. Kamera faqat yirik/mayda ajratadi; pul nazoratchi kiritgan toifalardan.",
      "type": "object",
      "required": ["gate_id", "direction", "camera_class", "count"],
      "additionalProperties": false,
      "properties": {
        "gate_id": {"type": "string"},
        "direction": {"type": "string", "enum": ["in", "out"]},
        "camera_class": {"type": "string", "enum": ["large", "small"]},
        "count": {"type": "integer", "minimum": 1},
        "confidence": {"$ref": "#/$defs/confidence"},
        "file_id": {"$ref": "#/$defs/file_id"}
      }
    },
    "livestock.vehicle.entered": {
      "description": "Mashina (yopiq ham) darvozadan kirdi — raqam avtomatik yoziladi; nazoratchi platformada topib, toifalarni kiritadi.",
      "type": "object",
      "required": ["vehicle_id", "gate_id"],
      "additionalProperties": false,
      "properties": {
        "vehicle_id": {"type": "string", "format": "uuid"},
        "gate_id": {"type": "string"},
        "plate": {"$ref": "#/$defs/plate"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "file_id": {"$ref": "#/$defs/file_id"}
      }
    },
    "livestock.vehicle.exited": {
      "type": "object",
      "required": ["vehicle_id", "gate_id"],
      "additionalProperties": false,
      "properties": {
        "vehicle_id": {"type": "string", "format": "uuid"},
        "gate_id": {"type": "string"},
        "plate": {"$ref": "#/$defs/plate"},
        "file_id": {"$ref": "#/$defs/file_id"}
      }
    },
    "livestock.fee.collected": {
      "type": "object",
      "required": ["counts", "amount_soum", "method"],
      "additionalProperties": false,
      "properties": {
        "vehicle_id": {"type": "string", "format": "uuid"},
        "counts": {
          "description": "Toifa kodi -> bosh soni (config.livestock.categories).",
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "amount_soum": {"type": "integer", "minimum": 0},
        "method": {"type": "string", "enum": ["cash", "terminal", "click", "payme"]}
      }
    },
    "livestock.watchlist.match": {
      "type": "object",
      "required": ["record_id", "similarity"],
      "additionalProperties": false,
      "properties": {
        "record_id": {"type": "string"},
        "similarity": {"$ref": "#/$defs/confidence"},
        "file_id": {"$ref": "#/$defs/file_id"}
      }
    }
  }
}

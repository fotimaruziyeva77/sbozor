# SBOZOR — muhit o'zgaruvchilari NAMUNASI.
#
# Bu fayl git'ga commit qilinadi va faqat KALIT NOMLARINI o'z ichiga oladi.
# HAQIQIY SIRLARNI BU YERGA YOZMANG — ular `.env` da (u `.gitignore` da).
#
#   cp .env.example .env
#

# --- PostgreSQL (db servisi) ---
POSTGRES_DB=sbozor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Ilova rollarining parollari — `ops/db/init/02-passwords.sh` shulardan o'rnatadi.
SBOZOR_OWNER_PASSWORD=
SBOZOR_APP_PASSWORD=

# --- Ilova ulanishlari ---
# DATABASE_URL — ILOVA roli (sbozor_app): NOSUPERUSER + NOBYPASSRLS, RLS'ga bo'ysunadi.
# Bu yerda HECH QACHON `postgres` superuseri ishlatilmaydi — aks holda tenant
# izolyatsiyasi butunlay yo'qoladi (FORCE ROW LEVEL SECURITY superuserni to'xtatmaydi).
DATABASE_URL=postgresql+asyncpg://sbozor_app:CHANGEME@db:5432/sbozor
# MIGRATION_DATABASE_URL — DDL EGASI (sbozor_owner), faqat `migrate` profilida ishlatiladi.
MIGRATION_DATABASE_URL=postgresql+asyncpg://sbozor_owner:CHANGEME@db:5432/sbozor
VALKEY_URL=redis://cache:6379/0

# --- Auth ---
# JWT_SECRET ni shu buyruq bilan hosil qiling (PyJWT 2.11+ HS256 uchun >= 32 bayt talab qiladi):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=sbozor
JWT_AUDIENCE=sbozor-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Dev'da HTTP ishlatiladi -> false. Prod'da (TLS ortida) MAJBURIY true.
COOKIE_SECURE=false

# --- NVR rekvizitlari (03-04, SC#4) ---
# Fernet kaliti — NVR parollari shu bilan shifrlanadi va bazada FAQAT
# shifrmatn yotadi. Hosil qiling:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#
# ⚠ BU KALIT `JWT_SECRET` DAN ALOHIDA VA UNDAN QIMMATROQ. Ikki xil xavf
#   modeli: JWT kalitini almashtirsangiz sessiyalar tushadi va hammasi
#   o'z-o'zidan tuzaladi; SHU kalitni yo'qotsangiz saqlangan NVR parollari
#   BUTUNLAY o'qib bo'lmas holga keladi va ularni faqat qo'lda, har bir
#   bozorga borib qayta kiritish mumkin. Zaxirasini sirlar omborida
#   ALOHIDA saqlang.
#
# ⚠ Kalit HECH QACHON bazada saqlanmaydi (`pgcrypto` ataylab rad etilgan):
#   bazaga kirgan odam shifrmatnni ko'radi, kalitni emas.
NVR_CREDENTIAL_KEY=
#
# Iste'foga chiqqan kalitlar — VERGUL bilan, ixtiyoriy (rotatsiya hali
# bo'lmagan o'rnatmada bo'sh qoladi). Semantikasi: birinchi (yuqoridagi)
# kalit YOZADI, bu yerdagilar esa faqat ESKI qatorlarni O'QIYDI.
#
# ROTATSIYA TARTIBI: eski `NVR_CREDENTIAL_KEY` ni shu qatorga ko'chiring ->
# yangisini yuqoriga qo'ying -> qayta ishga tushiring -> qatorlarni qayta
# shifrlang -> ish ro'yxati bo'shagach eskisini bu yerdan olib tashlang.
# To'liq bayoni: `services/core-api/app/security/secrets.py` docstringi.
NVR_CREDENTIAL_KEYS_RETIRED=

# --- Reverse proxy (CR-04) ---
# uvicorn `X-Forwarded-For` ni FAQAT shu ro'yxatdagi manzildan qabul qiladi
# (standart — `127.0.0.1`). nginx compose tarmog'ida boshqa konteyner manzilida
# turadi, ya'ni ro'yxat kengaytirilmasa HAQIQIY MIJOZ IP'si yo'qoladi: login
# rate-limit butun platforma uchun bitta sanagichga aylanadi (~51 anonim so'rov
# hammani qulflaydi) va `audit_log.ip` proxy manzilini yozadi.
#
# `*` NI HECH QACHON YOZMANG. Wildcard uvicornni `always_trust` rejimiga
# o'tkazadi va u zanjirning BIRINCHI (chap) elementini oladi — ya'ni qiymatni
# mijozning o'zi tanlaydi: rate-limit chetlab o'tiladi, istalgan qurbonni 15
# daqiqaga qulflash mumkin bo'ladi va `audit_log.ip` soxta yoziladi.
# Aniq ro'yxat berilganda uvicorn zanjirni O'NGDAN CHAPGA yurib birinchi
# ishonchsiz hop'da to'xtaydi — bu to'g'ri algoritm.
#
# QIYMAT EMPIRIK o'lchangan (2026-07-29):
#   docker network inspect sbozor_default --format '{{json .IPAM.Config}}'
#   -> [{"Subnet":"172.19.0.0/16","Gateway":"172.19.0.1"}]
# Kuzatilgan /16 QADALMAYDI: Docker bridge subnetlarini standart puldan
# (172.16.0.0/12 -> /16 bo'laklar) dinamik beradi, ya'ni tarmoq qayta
# yaratilsa u 172.20.x / 172.21.x bo'lib qolishi mumkin va qadalgan /16
# jimgina ishlamay qo'yardi. Shuning uchun butun pul beriladi.
#
# Prod'da toraytiring: compose tarmog'iga aniq subnet bering va shu yerga
# aynan o'sha /16 ni (yoki nginx konteynerining manzilini) yozing.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- Snapshot ombori (04-01, CAM-07) ---
# S3-mos ombor — `storage` xizmati (SeaweedFS). Endpoint compose tarmog'ining
# ICHIDA: ombor xost portiga publish QILINMAYDI (T-04-02).
S3_ENDPOINT_URL=http://storage:8333
S3_BUCKET=sbozor-snapshots
#
# ⚠ BU IKKI KALIT `ops/seaweedfs/s3.json` DAGI QIYMAT BILAN AYNAN BIR XIL
#   BO'LISHI SHART. Ajralib ketsa nosozlik shakli yomon: konteynerlar
#   muvaffaqiyatli ko'tariladi va xato faqat BIRINCHI KADRNI yuklashda
#   (ertalab 06:00 da) `SignatureDoesNotMatch` bo'lib chiqadi.
#   To'liq yo'riqnoma: `ops/seaweedfs/README.md`.
#
#   Hosil qiling:
#     python -c "import secrets;print(secrets.token_urlsafe(24))"   # access
#     python -c "import secrets;print(secrets.token_urlsafe(48))"   # secret
#
#   compose'da bu ikkisiga `:-` bilan bo'sh standart ATAYIN berilmagan
#   (`NVR_CREDENTIAL_KEY` bilan bir xil qaror): bo'sh standart bilan servis
#   ko'tarilardi va xato faqat ish paytida chiqardi.
#
# ⚠ QUYIDAGI IKKI QATOR `ops/seaweedfs/s3.json.example` BILAN JUFTLIK.
#   Ular AYNAN bir xil qiymat tashiydi va biri o'zgarsa ikkinchisi ham
#   o'zgaradi. Juftlik `tests/unit/test_storage_config.py` da TENGLIK
#   sifatida qulflangan — mahalliy `.env` faylingiz o'qilmaydi, faqat
#   shu ikki NAMUNA fayl solishtiriladi.
#
#   Qiymatning O'ZI «bu namuna, almashtiring» deb turibdi, ya'ni uni prod
#   qiymati bilan adashtirib bo'lmaydi. Bo'sh qoldirish esa YAROQSIZ edi:
#   `Settings` bo'sh S3 kalitini ishga tushishda RAD ETADI (T-04-29), ya'ni
#   `cp .env.example .env` qilgan yangi klonda `npm run up` `worker` va
#   `scheduler` ni yiqitardi va sabab faqat `docker compose logs` da qolardi.
#   ⚠ Bu `TELEGRAM_BOT_TOKEN` dan TESKARI: u yerda bo'shlik qonuniy ish
#     rejimi, bu yerda esa bo'shlik faqat yiqilish.
S3_ACCESS_KEY=NAMUNA-ALMASHTIRING-access
S3_SECRET_KEY=NAMUNA-ALMASHTIRING-secret

# --- Telegram alertlari (04-08, FOUND-06) ---
# ⚠ YUQORIDAGI S3 KALITLARIDAN TESKARI: bo'sh qiymat — QONUNIY holat.
#   Bo'sh token «alertlar o'chiq» degani, jarayon bir marta `log.warning`
#   yozadi va kadr olish DAVOM ETADI. Alertsiz kadr — alertli kadrsizlikdan
#   yaxshiroq (D-19).
#
# ⚠ ALERTGA KADR RASMI HECH QACHON BIRIKTIRILMAYDI. Dalil-kadrlar shaxsiy
#   ma'lumot, Telegram serverlari esa loyiha zimmasiga olgan O'zR
#   data-rezidentlik chegarasidan tashqarida. Faqat matn va sonlar (D-19).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Kadr olish (04-05/04-07, CAM-05) ---
# Slot vaqti o'tgach kadr olish uchun beriladigan muhlat. Undan keyin slot
# `missed` bo'lib YO'QLIK YOZUVI sifatida qoladi (D-20: alert muvaffaqiyat
# signalining YO'QLIGIGA qo'yiladi, faqat xato chiqish kodiga emas).
# 600 s — D-08 arifmetikasi: 25 kamera to'liq ketma-ket ~100 s.
CAPTURE_GRACE_SECONDS=600
# Bitta NVR ga bir vaqtda nechta kadr so'rovi ketadi (D-08). Standart 1
# (ketma-ket) — NVR ning O'LCHANMAGAN sessiya chegarasi shu bilan fazani
# HECH QACHON bloklay olmaydi, faqat kechikish narxini beradi.
CAPTURE_GLOBAL_CONCURRENCY=1
# Bitta slot uchun urinishlar soni. ⚠ `401`/`403` da retry QILINMAYDI —
# Hikvision hisobni ~5 urinishdan keyin QULFLAYDI (03-05 dan meros, teskari
# retry siyosati).
CAPTURE_MAX_ATTEMPTS=3
# Server tomonidagi qattiq chegara: bitta bozor uchun kuniga nechta slot.
# UI 12 tani ko'rsatadi, server esa buni MAJBURLAYDI (mijoz tekshiruvi
# darvoza emas). Standart profil — 7 slot (D-01).
SNAPSHOT_MAX_TIMES_PER_DAY=12

# --- Saqlash siyosati (04-08, CAM-07, D-18) ---
# 90 kun to'liq sifat + 365 kun siqilgan = 455 kun. Ikkala qiymat ham shu
# yerda, ya'ni buyurtmachi javobiga qarab BITTA SON o'zgaradi.
RETENTION_FULL_DAYS=90
RETENTION_COMPRESSED_DAYS=365
# Siqishdan keyingi JPEG sifati (Pillow `quality=`).
RETENTION_JPEG_QUALITY=60
# Bitta yugurishda nechta obyekt qayta ishlanadi — ombor va bazani bir
# marta uzoq bloklamaslik uchun.
RETENTION_BATCH_SIZE=200

# --- Sifat filtri chegaralari (04-04, CAM-06, D-14/D-15) ---
# ⚠ BU QIYMATLAR HOZIRCHA `LOW CONFIDENCE` — real Karmana kadri hali yo'q.
#   Ular ATAYIN sozlanadigan: D-15 bo'yicha O'LCHOVLARNING O'ZI bazada
#   saqlanadi, ya'ni Phase 0 ning real kadrlari kelganda chegaralar SQL
#   bilan sozlanadi, qayta kadr olish bilan EMAS.
#
# ⚠ `dark` IKKI SHARTLI (D-14): `mean < X` VA `stddev < Y`. Faqat
#   o'rtachaga tayangan qoida qonuniy qish-tong kadrlarini OYLAB jimgina
#   tashlab yuborardi.
QUALITY_DARK_MEAN_MAX=25
QUALITY_DARK_STDDEV_MAX=12
# Deyarli bir xil rangli kadr (ob'ektiv yopilgan, signal yo'qolgan).
QUALITY_BLANK_STDDEV_MAX=3
# Kadrning eng kichik yo'l qo'yiladigan hajmi (bayt) — undan kichigi
# kesilgan yoki HTML xato sahifasi bo'lishi mumkin.
QUALITY_MIN_BYTES=4096

# --- Kuzatuv ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Vaqt mintaqasi ---
# Konteyner soati Asia/Tashkent, LEKIN kodda har doim aniq ZoneInfo ishlatiladi —
# TZ o'zgaruvchisiga tayanilmaydi (biznes-kun chegarasi buzilmasligi uchun).
TZ=Asia/Tashkent

# --- Frontend ---
# Bitta domen topologiyasi: nginx `/api/` -> core-api, `/` -> frontend.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# --- Dev xost portlari (IXTIYORIY) ---
# `compose.override.yml` servislarni FAQAT 127.0.0.1 ga bog'laydi. Agar xostda
# mahalliy Postgres/Redis/nginx allaqachon shu portlarni band qilgan bo'lsa,
# shu yerda boshqa raqam bering — bog'lanish interfeysi (127.0.0.1) o'zgarmaydi.
# DB_HOST_PORT=5432
# CACHE_HOST_PORT=6379
# API_HOST_PORT=8000
# PROXY_HOST_PORT=8080

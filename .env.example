# SBOZOR — muhit o'zgaruvchilari NAMUNASI.
#
# Bu fayl git'ga commit qilinadi va faqat KALIT NOMLARINI o'z ichiga oladi.
# HAQIQIY SIRLARNI BU YERGA YOZMANG — ular `.env` da (u `.gitignore` da).
#
#   cp .env.example .env
#

# --- PostgreSQL (db servisi) ---
POSTGRES_DB=sbozor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Ilova rollarining parollari — `ops/db/init/02-passwords.sh` shulardan o'rnatadi.
SBOZOR_OWNER_PASSWORD=
SBOZOR_APP_PASSWORD=

# --- Ilova ulanishlari ---
# DATABASE_URL — ILOVA roli (sbozor_app): NOSUPERUSER + NOBYPASSRLS, RLS'ga bo'ysunadi.
# Bu yerda HECH QACHON `postgres` superuseri ishlatilmaydi — aks holda tenant
# izolyatsiyasi butunlay yo'qoladi (FORCE ROW LEVEL SECURITY superuserni to'xtatmaydi).
DATABASE_URL=postgresql+asyncpg://sbozor_app:CHANGEME@db:5432/sbozor
# MIGRATION_DATABASE_URL — DDL EGASI (sbozor_owner), faqat `migrate` profilida ishlatiladi.
MIGRATION_DATABASE_URL=postgresql+asyncpg://sbozor_owner:CHANGEME@db:5432/sbozor
VALKEY_URL=redis://cache:6379/0

# --- Auth ---
# JWT_SECRET ni shu buyruq bilan hosil qiling (PyJWT 2.11+ HS256 uchun >= 32 bayt talab qiladi):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=sbozor
JWT_AUDIENCE=sbozor-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Dev'da HTTP ishlatiladi -> false. Prod'da (TLS ortida) MAJBURIY true.
COOKIE_SECURE=false

# --- Reverse proxy (CR-04) ---
# uvicorn `X-Forwarded-For` ni FAQAT shu ro'yxatdagi manzildan qabul qiladi
# (standart — `127.0.0.1`). nginx compose tarmog'ida boshqa konteyner manzilida
# turadi, ya'ni ro'yxat kengaytirilmasa HAQIQIY MIJOZ IP'si yo'qoladi: login
# rate-limit butun platforma uchun bitta sanagichga aylanadi (~51 anonim so'rov
# hammani qulflaydi) va `audit_log.ip` proxy manzilini yozadi.
#
# `*` NI HECH QACHON YOZMANG. Wildcard uvicornni `always_trust` rejimiga
# o'tkazadi va u zanjirning BIRINCHI (chap) elementini oladi — ya'ni qiymatni
# mijozning o'zi tanlaydi: rate-limit chetlab o'tiladi, istalgan qurbonni 15
# daqiqaga qulflash mumkin bo'ladi va `audit_log.ip` soxta yoziladi.
# Aniq ro'yxat berilganda uvicorn zanjirni O'NGDAN CHAPGA yurib birinchi
# ishonchsiz hop'da to'xtaydi — bu to'g'ri algoritm.
#
# QIYMAT EMPIRIK o'lchangan (2026-07-29):
#   docker network inspect sbozor_default --format '{{json .IPAM.Config}}'
#   -> [{"Subnet":"172.19.0.0/16","Gateway":"172.19.0.1"}]
# Kuzatilgan /16 QADALMAYDI: Docker bridge subnetlarini standart puldan
# (172.16.0.0/12 -> /16 bo'laklar) dinamik beradi, ya'ni tarmoq qayta
# yaratilsa u 172.20.x / 172.21.x bo'lib qolishi mumkin va qadalgan /16
# jimgina ishlamay qo'yardi. Shuning uchun butun pul beriladi.
#
# Prod'da toraytiring: compose tarmog'iga aniq subnet bering va shu yerga
# aynan o'sha /16 ni (yoki nginx konteynerining manzilini) yozing.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- Kuzatuv ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Vaqt mintaqasi ---
# Konteyner soati Asia/Tashkent, LEKIN kodda har doim aniq ZoneInfo ishlatiladi —
# TZ o'zgaruvchisiga tayanilmaydi (biznes-kun chegarasi buzilmasligi uchun).
TZ=Asia/Tashkent

# --- Frontend ---
# Bitta domen topologiyasi: nginx `/api/` -> core-api, `/` -> frontend.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# --- Dev xost portlari (IXTIYORIY) ---
# `compose.override.yml` servislarni FAQAT 127.0.0.1 ga bog'laydi. Agar xostda
# mahalliy Postgres/Redis/nginx allaqachon shu portlarni band qilgan bo'lsa,
# shu yerda boshqa raqam bering — bog'lanish interfeysi (127.0.0.1) o'zgarmaydi.
# DB_HOST_PORT=5432
# CACHE_HOST_PORT=6379
# API_HOST_PORT=8000
# PROXY_HOST_PORT=8080

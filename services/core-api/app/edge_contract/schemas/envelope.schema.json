{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sbozor.uz/agent/v1/envelope.schema.json",
  "title": "Hodisa konverti (agent -> server)",
  "description": "Har bir hodisa shu konvertga o'raladi. Modulga xos ma'lumot faqat `data` ichida. Protokol v1, 7-bo'lim.",
  "type": "object",
  "required": ["id", "type", "v", "site_id", "agent_id", "seq", "occurred_at", "clock_ok", "data"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "UUIDv7, agentda yaratiladi; dublikatni aniqlash kaliti.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "description": "<modul>.<obyekt>.<harakat>; yadro hodisalari core.*",
      "type": "string",
      "pattern": "^(core|market|parking|livestock)\\.[a-z][a-z_]*\\.[a-z][a-z_]*$"
    },
    "v": {"description": "Shu `type` ma'lumot sxemasining versiyasi.", "type": "integer", "minimum": 1},
    "site_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "seq": {"description": "Agentdagi uzluksiz tartib raqami.", "type": "integer", "minimum": 1},
    "occurred_at": {
      "description": "Hodisa haqiqatda bo'lgan vaqt, mintaqa bilan (ISO 8601).",
      "type": "string",
      "format": "date-time"
    },
    "clock_ok": {"description": "Agent soati server bilan tekshirilganmi.", "type": "boolean"},
    "correlation_id": {
      "description": "Bir jarayonga tegishli hodisalarni bog'laydi (masalan seans ID).",
      "type": "string",
      "format": "uuid"
    },
    "data": {"type": "object"}
  }
}
